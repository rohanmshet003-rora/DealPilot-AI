# ==============================================================================
# DealPilot AI — Root .gitignore
# Exclude sensitive environment secrets, build outputs, and system dependencies
# ==============================================================================

# 1. Environment Secrets & Credentials (NEVER COMMIT)
.env
.env.*
!.env.example
*.env
*.env.*
*.key
*.pem
*.cert

# 2. Node.js Dependencies & Package Logs
node_modules/
*/node_modules/
*/*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 3. Build & Distribution Outputs
dist/
dist-ssr/
build/
client/dist/
*.local

# 4. Local SQLite Database & Storage Files
*.db
*.db-shm
*.db-wal
dealpilot.db
dealpilot.db-shm
dealpilot.db-wal
server/db/*.db
server/db/*.db-shm
server/db/*.db-wal

# 5. macOS System Artifacts & Desktop Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.DS_Store

# 6. Editor & IDE Settings
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 7. Test & Code Coverage
coverage/
.nyc_output/

# 8. Temporary & Cache Directories
.cache/
.vite-temp/
*.tmp
*.temp

# Local workspace alias directory
dealpilot-ai/
