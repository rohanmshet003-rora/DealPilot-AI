# ==============================================================================
# DealPilot AI - Server Environment Configuration Template
# "Negotiate Smarter. Deal Better. Close with Confidence."
# ==============================================================================
# Copy this file to .env and replace all placeholder values with your real credentials.
# NEVER commit the actual .env file containing secret keys to version control.
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication & Session Security (Keep secret, min 32 chars)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Option 1 (Recommended for Node/Express): Transaction / Session Pooler URL
# Port 6543 (Transaction mode) or Port 5432 (Session mode)
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Enable SSL for Supabase connection (true for remote Supabase; false for local testing)
DATABASE_SSL=true

# ------------------------------------------------------------------------------
# Supabase API & Project Credentials (Server-side)
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# Public Anonymous Key (safe for client / public queries with RLS)
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
# Service Role Secret (Privileged server-only key. NEVER expose to frontend!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# Agora RTC Voice Calling Engine
# ------------------------------------------------------------------------------
# Found in: Agora Console -> Project Management -> Project Details
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here
AGORA_TOKEN_EXPIRATION=7200

# ------------------------------------------------------------------------------
# Google Gemini Generative AI Engine
# ------------------------------------------------------------------------------
# Found in: Google AI Studio -> API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
